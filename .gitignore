# Dependencies and generated output
node_modules/
dist/
coverage/
.venv/
__pycache__/
*.pyc

# Relatórios de construção: têm timestamp e não interessam ao versionamento.
# Os artefactos que o site consome (progress-taxonomy.json, template-schema.json)
# são gerados, mas versionados de propósito, para que o build funcione sem rede.
build/*
!build/progress-taxonomy.json
!build/template-schema.json

# Local logs and editor/OS files
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local environment files (keep the example file)
.env
.env.*
!.env.example

# Agent and planning material (not part of the website)
.github/agents/
.github/prompts/
.github/skills/
**/AGENTS.md
**/*.agent.md
100Notes/
