{
  "$comment": "Ficheiro de configuração do pipeline editorial. É o ÚNICO ficheiro que precisa de editar para mudar caminhos, nomes ou opções. Não precisa de saber programar.",

  "editorial": {
    "$comment": "Os três documentos Word que formam o conteúdo do kit, por ordem de leitura.",
    "sources": [
      { "id": "source1", "file": "source/source1.docx", "label": "Parte 1" },
      { "id": "source2", "file": "source/source2.docx", "label": "Parte 2" },
      { "id": "games", "file": "source/gamesSource.docx", "label": "Jogos e Workshops" }
    ],
    "fallbackFile": "file.md",
    "fallbackComment": "Fonte editorial já montada. Só é usada para preencher jogos que faltam no Word."
  },

  "games": {
    "$comment": "Geração das fichas de jogo. n vai de 0 (molde) a 30.",
    "template": "source/games/00GameSheetTemplate.docx",
    "outputDir": "source/games",
    "mapFile": "content/games-map.json",
    "firstNumber": 1,
    "lastNumber": 30,
    "expectedCount": 30,
    "extensions": { "canonical": ".md", "print": ".html" },
    "areas": [
      "Área das Pessoas",
      "Área do Planeta",
      "Área da Prosperidade",
      "Área da Paz",
      "Área das Parcerias"
    ],
    "areasPerGroup": 6
  },

  "report": {
    "file": "build/content-report.json",
    "console": true
  },

  "build": {
    "dir": "build"
  },

  "progress": {
    "$comment": "Personal Progress. Os valores editoriais (label, branch, ages, color, referenceUrl) vêm daqui; a taxonomia vem sempre do Google Sheet.",
